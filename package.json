{
  "name": "spotiland",
  "version": "0.2.0",
  "description": "Spotiland - Your ultimate soptify profile and AI helper",
  "main": "server/index.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/EHsieh0212/Spotiland.git"
  },
  "keywords": ["spotiland"],
  "author": "chia ying hsieh",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/EHsieh0212/Spotiland/issues"
  },
  "homepage": "https://github.com/EHsieh0212/Spotiland#read-me",
  "engines": {
    "node": "19.2.0", 
    "npm": "8.19.3"
  },
  "cacheDirectories": [
    "node_modules",
    "client/node_modules"
  ],
  "scripts": {
    "install": "cd client && npm install --force",
    "build": "cd client/ && npm install --force",
    "debug": "WORK_STAGE=develop nodemon node server",
    "dev-server": "nodemon server",
    "server": "WORK_STAGE=production node server",
    "client": "cd client && npm start",
    "dev": "WORK_STAGE=develop concurrently --kill-others-on-fail \"npm run dev-server\" \"npm run client\"",
    "eslint": "eslint --fix . --ext .js"
  },
  "dependencies": {
    "connect-history-api-fallback": "^2.0.0",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.0.3",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.0",
    "request": "^2.88.2"
  },
  "devDependencies": {
    "concurrently": "^5.3.0",
    "eslint": "^8.51.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-config-standard": "^17.1.0",
    "eslint-plugin-import": "^2.28.1",
    "eslint-plugin-n": "^16.1.0",
    "eslint-plugin-prettier": "^5.0.0",
    "eslint-plugin-promise": "^6.1.1",
    "eslint-plugin-react": "^7.33.2",
    "nodemon": "^3.0.1"
  }
}
