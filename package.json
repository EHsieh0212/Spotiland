{
  "name": "spotiland",
  "version": "0.1.0",
  "description": "spotiland",
  "main": "server/index.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/EHsieh0212/Spotiland.git"
  },
  "keywords": [],
  "author": "chia ying hsieh",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/EHsieh0212/Spotiland/issues"
  },
  "homepage": "/",
  "engines": {
    "node": "19.2.0"
  },
  "cacheDirectories": [
    "node_modules",
    "client/node_modules"
  ],
  "scripts": {
    "install": "cd client && npm install --force",
    "build": "NODE_ENV=production cd client/ && npm install --force",
    "dev-server": "nodemon server",
    "dev-client": "cd client && npm start",
    "dev": "concurrently --kill-others-on-fail \"npm run dev-server\" \"npm run dev-client\"",
    "start-server": "cd server/ && nodemon index.js"
    
  },
  "dependencies": {
    "cluster": "^0.7.7",
    "connect-history-api-fallback": "^2.0.0",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.0.3",
    "express": "^4.18.2",
    "querystring": "^0.2.1",
    "request": "^2.88.2"
  },
  "devDependencies": {
    "concurrently": "^5.3.0",
    "nodemon": "^3.0.1"
  }
}
